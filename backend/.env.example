# Database (SQLite by default for zero-setup local dev; swap for Postgres in production)
DATABASE_URL=sqlite:///./careerpath.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/careerpath

# Set to false once you're running `alembic upgrade head` yourself (e.g. production) —
# leave as true (default) for zero-setup local dev, where the app creates tables itself.
AUTO_CREATE_TABLES=true

# Auth (dev JWT secret — replace, and/or swap in real Firebase Admin verification)
JWT_SECRET=change-this-dev-secret
JWT_EXPIRE_MINUTES=1440

# Firebase Admin (server-side only — for production Firebase Auth verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini (AI reasoning layer — app runs on deterministic engine if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# External data providers
COLLEGE_API_KEY=
MAP_PROVIDER=osm-nominatim
MAP_API_KEY=
